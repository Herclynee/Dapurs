# Auto detect text files and perform LF normalization
* text=auto

# Unity files
*.cs text diff=csharp
*.unity text
*.asset text
*.meta text
*.prefab text
*.mat text
*.shader text
*.anim text
*.controller text
*.overrideController text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tga binary
*.psd binary
*.fbx binary
*.obj binary
*.wav binary
*.mp3 binary
*.ogg binary
*.dll binary
*.so binary
*.dylib binary
*.exe binary
*.zip binary
*.rar binary
*.7z binary